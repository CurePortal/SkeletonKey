# Copy to server/.env and edit.

# Shared secret between the phone app and beacond (auth).
#   openssl rand -hex 32
BEACON_TOKEN=

# Optional end-to-end encryption key (64 hex chars = 32 bytes). When set, position
# pings and agent->phone messages are AES-256-GCM encrypted, so a tunnel edge sees
# only ciphertext. Must match the key baked into / entered in the app.
#   openssl rand -hex 32
BEACON_KEY=

# Where beacond listens. Keep it on loopback and expose it through your own tunnel.
BEACON_HOST=127.0.0.1
BEACON_PORT=8787

# The agent server that the phone's /ask path drives (opencode serve).
# OPENCODE_URL=http://127.0.0.1:4096

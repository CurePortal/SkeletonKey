# WhatsApp Agent Platform bridge for opencode / SkeletonKey.
# Copy to .env and fill in. Never commit the real .env.

# The agent API key from WhatsApp > Settings > Agents.
# One key = one agent chat. Use a separate key for each silo (/bean, /bella, HQ).
WA_AGENT_API_KEY=
# WA_AGENT_BASE=https://api.whatsapp.com/agent/v1

# The opencode server the bridge drives.
OPENCODE_URL=http://127.0.0.1:4096
# OPENCODE_DIRECTORY=/path/to/your/workdir
# Optional per-turn model/agent overrides.
# OPENCODE_AGENT=whatsapp
# OPENCODE_MODEL=ollama-cloud/deepseek-v4.1-flash

# Pin every message in this chat to one agent. Empty = use prefixes/routes.
# WA_AGENT_ONLY=whatsapp

# Prefix routes (only used when WA_AGENT_ONLY is empty).
# WA_BEN_PREFIX=/ben
# WA_BEN_AGENT=bean
# WA_BELLA_PREFIX=/bella
# WA_BELLA_AGENT=bella

# Permission handling for commands/edits/fetches raised by the agent:
#   reject (default) | ask | once | always
# "ask" relays each request to the chat and waits for yes/no.
WA_PERMISSION_MODE=ask

# Image turns go to a vision-capable model. The local text-only model is not
# enough; point this at a provider/model that advertises image input.
WA_MEDIA_MODEL=ollama-cloud/deepseek-v4.1-flash
# WA_MEDIA_INBOX=~/.local/state/wa-media

# Optional company pipelines (only used by the bean/petbook routes).
# WA_BEANCOUNT_DIR=~/beancount
# WA_PETBOOK_DIR=~/petbook

# Per-instance state (separate files let several bridges run side by side).
# WA_AGENT_STATE_FILE=~/.local/state/wa-agent-bridge.json

# WA_REPLY_TIMEOUT_MS=600000

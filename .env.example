# SkeletonKey frontend build-time settings.
# Copy to .env.local for local overrides. Never commit real keys.

# Optional: a CARTO basemap key. Without one the app uses key-free OpenStreetMap
# tiles. It can also be entered in Settings at runtime.
VITE_CARTO_KEY=

# Local services (defaults shown). Override only if you moved the ports.
# VITE_GEO_URL=http://127.0.0.1:8788
# VITE_HQ_URL=http://127.0.0.1:8799

# Optional: the hostname of a browser deployment, so the app does not mistake it
# for the Tauri desktop shell. Leave empty for localhost/dev.
# VITE_WEBAPP_HOST=app.example.com

# Beancount / Fava (optional personal finances).
# The ledger file and Fava URL can also be set in Settings → Finances.
BEANCOUNT_FILE=~/Documents/SkeletonKey/finances/main.beancount
FAVA_URL=http://127.0.0.1:5001
